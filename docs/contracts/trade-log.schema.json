{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oft.local/v1/trade-log.schema.json",
  "title": "Trade log / review record",
  "description": "A closed trade with PnL definitions fixed by code. The LLM review is advisory and can never modify rules. Signal references make the signal-to-outcome comparison auditable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trade_id",
    "position_id",
    "account_id",
    "environment",
    "symbol",
    "side",
    "opened_at",
    "closed_at",
    "entry_avg_price",
    "exit_avg_price",
    "size",
    "gross_pnl_usd",
    "fees_usd",
    "funding_usd",
    "net_pnl_usd",
    "r_multiple",
    "mae_usd",
    "mfe_usd",
    "return_pct",
    "signal",
    "decision_quality",
    "outcome_tags",
    "review_decision_id",
    "data_quality",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "trade_id": { "$ref": "./common.schema.json#/$defs/id" },
    "position_id": { "$ref": "./common.schema.json#/$defs/id" },
    "account_id": { "$ref": "./common.schema.json#/$defs/id" },
    "environment": { "$ref": "./common.schema.json#/$defs/environment" },
    "symbol": { "$ref": "./common.schema.json#/$defs/symbol" },
    "side": { "$ref": "./common.schema.json#/$defs/positionSide" },
    "opened_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "closed_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "entry_avg_price": { "$ref": "./common.schema.json#/$defs/decimal" },
    "exit_avg_price": { "$ref": "./common.schema.json#/$defs/decimal" },
    "size": { "$ref": "./common.schema.json#/$defs/decimal" },
    "gross_pnl_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "fees_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "funding_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "net_pnl_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "r_multiple": { "type": ["number", "null"] },
    "mae_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "mfe_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "return_pct": { "type": "number" },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "report_id", "opportunity_id", "trigger_id", "decision_id"],
      "properties": {
        "scan_id": { "type": ["string", "null"] },
        "report_id": { "type": ["string", "null"] },
        "opportunity_id": { "type": ["string", "null"] },
        "trigger_id": { "type": ["string", "null"] },
        "decision_id": { "type": ["string", "null"] }
      }
    },
    "decision_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched_rules", "confidence", "notes"],
      "properties": {
        "matched_rules": {
          "type": ["boolean", "null"],
          "description": "Human/automated review of whether the entry and exit followed the pre-declared rules. Null when not reviewed."
        },
        "confidence": { "type": ["number", "null"] },
        "notes": { "type": "string" }
      }
    },
    "outcome_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_decision_id": {
      "anyOf": [{ "$ref": "./common.schema.json#/$defs/id" }, { "type": "null" }],
      "description": "LLM qualitative review. Advisory only; no rule changes are applied."
    },
    "data_quality": { "$ref": "./common.schema.json#/$defs/dataQualitySummary" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calc_metric_version", "prompt_version", "llm_provider", "llm_model"],
      "properties": {
        "calc_metric_version": { "type": "string" },
        "prompt_version": { "type": "integer", "minimum": 1 },
        "llm_provider": { "$ref": "./common.schema.json#/$defs/provider" },
        "llm_model": { "type": "string" }
      }
    }
  }
}
