{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oft.local/v1/budget-record.schema.json",
  "title": "LLM budget record",
  "description": "One priced LLM call. Tokens and unit prices are recorded per call; day/week/month rollups are derived, never hand-edited. Budget thresholds alert but do not hard-stop (PRD decision).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "call_id",
    "decision_id",
    "occurred_at",
    "provider",
    "model",
    "usage",
    "unit_prices",
    "cost_usd",
    "price_version",
    "unpriced",
    "period",
    "thresholds",
    "budget_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "record_id": { "$ref": "./common.schema.json#/$defs/id" },
    "call_id": { "$ref": "./common.schema.json#/$defs/id" },
    "decision_id": {
      "anyOf": [{ "$ref": "./common.schema.json#/$defs/id" }, { "type": "null" }]
    },
    "occurred_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "provider": { "$ref": "./common.schema.json#/$defs/provider" },
    "model": { "type": "string" },
    "usage": { "$ref": "./common.schema.json#/$defs/llmUsage" },
    "unit_prices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_per_mtok",
        "output_per_mtok",
        "cache_read_per_mtok",
        "cache_write_per_mtok",
        "currency"
      ],
      "properties": {
        "input_per_mtok": { "$ref": "./common.schema.json#/$defs/decimal" },
        "output_per_mtok": { "$ref": "./common.schema.json#/$defs/decimal" },
        "cache_read_per_mtok": { "$ref": "./common.schema.json#/$defs/decimal" },
        "cache_write_per_mtok": { "$ref": "./common.schema.json#/$defs/decimal" },
        "currency": { "type": "string", "enum": ["USD"] }
      }
    },
    "cost_usd": { "$ref": "./common.schema.json#/$defs/money" },
    "price_version": { "type": "string" },
    "unpriced": {
      "type": "boolean",
      "description": "True when the model/token class has no configured price. The record is still written and surfaced; it is never silently zero."
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "week", "month"],
      "properties": {
        "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily_usd", "weekly_usd", "monthly_usd", "warn_pct"],
      "properties": {
        "daily_usd": { "$ref": "./common.schema.json#/$defs/money" },
        "weekly_usd": { "$ref": "./common.schema.json#/$defs/money" },
        "monthly_usd": { "$ref": "./common.schema.json#/$defs/money" },
        "warn_pct": { "type": "number" }
      }
    },
    "budget_state": {
      "type": "string",
      "enum": ["OK", "WARN", "EXCEEDED"],
      "description": "WARN at the configured warn percentage, EXCEEDED at or above the threshold. Both alert; neither stops calls."
    }
  }
}
