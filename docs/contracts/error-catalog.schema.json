{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oft.local/v1/error-catalog.schema.json",
  "title": "Error catalog contract",
  "description": "Validates docs/contracts/error-catalog.json. The catalog is the source of truth for stable error codes; api-envelope.schema.json must contain the same enum. CI asserts both lists match.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "description", "categories", "codes"],
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AUTH",
          "VALIDATION",
          "CONFLICT",
          "DATA",
          "LLM",
          "RISK",
          "EXECUTION",
          "STORAGE",
          "UPSTREAM",
          "SYSTEM"
        ]
      }
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "httpStatus", "category", "retryable", "summary", "userAction"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
          "category": {
            "type": "string",
            "enum": [
              "AUTH",
              "VALIDATION",
              "CONFLICT",
              "DATA",
              "LLM",
              "RISK",
              "EXECUTION",
              "STORAGE",
              "UPSTREAM",
              "SYSTEM"
            ]
          },
          "retryable": { "type": "boolean" },
          "summary": { "type": "string" },
          "userAction": { "type": "string" }
        }
      }
    }
  }
}
