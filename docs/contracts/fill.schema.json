{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oft.local/v1/fill.schema.json",
  "title": "Fill",
  "description": "An execution against an order. Paper fills are simulated but use the same record shape as live fills, with source PAPER. Exchange trade IDs are unique per environment/symbol when present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fill_id",
    "order_id",
    "exchange_trade_id",
    "environment",
    "account_id",
    "symbol",
    "side",
    "price",
    "quantity",
    "quote_quantity",
    "fee",
    "fee_asset",
    "maker",
    "filled_at",
    "received_at",
    "source"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "fill_id": { "$ref": "./common.schema.json#/$defs/id" },
    "order_id": { "$ref": "./common.schema.json#/$defs/id" },
    "exchange_trade_id": { "type": ["string", "null"] },
    "environment": { "$ref": "./common.schema.json#/$defs/environment" },
    "account_id": { "$ref": "./common.schema.json#/$defs/id" },
    "symbol": { "$ref": "./common.schema.json#/$defs/symbol" },
    "side": { "$ref": "./common.schema.json#/$defs/orderSide" },
    "price": { "$ref": "./common.schema.json#/$defs/decimal" },
    "quantity": { "$ref": "./common.schema.json#/$defs/decimal" },
    "quote_quantity": { "$ref": "./common.schema.json#/$defs/money" },
    "fee": { "$ref": "./common.schema.json#/$defs/money" },
    "fee_asset": { "type": "string" },
    "maker": { "type": "boolean" },
    "filled_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "received_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "source": { "type": "string", "enum": ["WS", "REST", "PAPER"] }
  }
}
