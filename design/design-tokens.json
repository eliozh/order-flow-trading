      "nav": "208px expanded at >=1280px; 56px icon rail at 768-1279px; bottom tab bar at <768px",
      "inspector": "360px fixed at >=1280px; overlay sheet at <1280px",
      "contentPadding": "16px at <1024px; 24px at >=1024px"
    },
    "zIndex": {
      "base": 0,
      "stickyHeader": 10,
      "dropdown": 100,
      "inspectorSheet": 200,
      "modal": 300,
      "toast": 400,
      "killSwitch": 500
    }
  },
