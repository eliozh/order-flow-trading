      "info": "#62B6FF",
      "accent": "#4DD8E6",
      "muted": "#7C8898",
      "text": "#E8EDF2"
    },
    "rules": [
      "text.muted must not be used on background.selected, accent.mutedSurface, or inside any chip background. Use text.secondary in those contexts.",
      "text.disabled is inactive-only. It must never carry values, status, errors, timestamps, or axis labels.",
      "border.control is required for inputs, selects, checkboxes, radios, switches, segmented controls, and search fields. border.default and border.strong are panel edges and table dividers only (decorative, exempt from 3:1).",
      "Chart volume direction must not rely on hue alone: up bars carry a 1px full-strength top cap; down bars carry a 1px full-strength outline."
    ]
  },
  "typography": {
    "fontFamily": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "mono": "ui-monospace, \"SFMono-Regular\", \"JetBrains Mono\", \"Cascadia Code\", \"Roboto Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
      "numeric": "ui-monospace, \"SFMono-Regular\", \"JetBrains Mono\", \"Cascadia Code\", \"Roboto Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "size": {
      "micro": "11px",
      "caption": "12px",
      "data": "13px",
      "body": "14px",
      "title3": "16px",
      "title2": "20px",
      "title1": "24px",
      "display": "32px"
    },
    "lineHeight": {
      "tight": 1.2,
      "data": 1.35,
      "body": 1.6,
      "loose": 1.75
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "label": "0.04em",
      "stamp": "0.08em"
    },
    "numeric": {
      "fontVariantNumeric": "tabular-nums slashed-zero",
      "fontFeatureSettings": "\"tnum\" 1, \"zero\" 1",
      "alignment": "right",
      "decimalPolicy": "Always show the symbol tick precision; no locale thousands separator in dense tables."
    }
  },
