  },
  "border": {
    "width": {
      "hairline": "1px",
      "thick": "2px",
      "accentRule": "2px"
    },
    "style": {
      "solid": "solid",
      "dashed": "dashed",
      "dotted": "dotted"
    },
    "default": "1px solid #262C36",
    "subtle": "1px solid #1D222B",
    "strong": "1px solid #3A424F"
  },
  "elevation": {
    "e0": {
      "boxShadow": "none",
      "border": "1px solid #262C36",
      "usage": "Every panel, table, and toolbar"
    },
    "e1": {
      "boxShadow": "0 4px 12px #07080A66",
      "border": "1px solid #3A424F",
      "usage": "Popover, dropdown, inspector sheet"
    },
    "e2": {
      "boxShadow": "0 16px 48px #07080A99",
      "border": "1px solid #3A424F",
      "usage": "Modal dialog"
    },
    "e3": {
      "boxShadow": "0 24px 64px #07080AB8",
      "border": "1px solid #FF5D6A",
      "usage": "Live-arming confirmation only"
    },
    "rule": "No soft ambient card shadows. Structure comes from borders and background steps; shadows exist only to lift overlays off the grid."
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "70ms",
      "base": "120ms",
      "medium": "180ms",
      "slow": "240ms",
      "priceFlash": "600ms",
      "skeletonPulse": "1400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "linear": "linear"
    },
    "reducedMotion": {
      "duration": "0.01ms",
      "iterationCount": 1,
      "usage": "Respect prefers-reduced-motion; disable price flash, pulse, and pane transitions."
    },
    "rules": [
      "Animate color and opacity only; never animate chart geometry or table row height.",
      "No scroll-triggered reveals, parallax, or decorative loops.",
      "Live price/value updates flash the background for 600ms and settle; do not animate the digits."
    ]
  },
  "focus": {
    "ring": {
      "color": "#4DD8E6",
      "width": "2px",
      "offset": "2px",
      "style": "solid"
    },
    "inset": {
      "color": "#4DD8E6",
      "width": "2px",
      "offset": "-2px",
      "style": "solid"
    },
    "rule": "Use :focus-visible. Never remove the ring. On dense tables, the row focus ring is inset; on buttons and inputs it is outset."
  },
  "layout": {
    "breakpoints": {
      "xs": "375px",
      "sm": "768px",
      "md": "1024px",
      "lg": "1280px",
      "xl": "1440px",
      "xxl": "1920px"
