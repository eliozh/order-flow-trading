    "name": "Order Flow Trading System",
    "version": "1.0.0",
    "mode": "dark-first",
    "status": "stage-3-direction",
    "updated": "2026-11-06",
    "description": "High-contrast market-terminal token set for the CLI and Web UI. Dark-first, sharp-edged, data-dense. Semantic market colors are reserved and must not be used for decoration.",
