    "paneGap": "1px",
    "axisWidth": "64px",
    "candle": {
      "bodyMinWidth": "1px",
      "bodyMaxWidth": "18px",
      "wickWidth": "1px",
      "borderVisible": false
    },
    "footprint": {
      "cellMinWidth": "52px",
      "cellHeight": "18px",
      "priceStepRows": "one row per tick-bucket; collapse empty buckets",
      "maxRows": "40 visible"
    },
    "volumeProfile": {
      "width": "18% of plot",
      "bins": 60
    },
    "tooltip": {
      "delayMs": 120,
      "maxWidth": "320px"
    },
    "timeframes": [
      "15m",
      "1h",
      "4h"
    ],
    "defaults": {
      "timeframe": "4h",
      "showVolume": true,
      "showCvd": true,
      "showVolumeProfile": true,
      "showFootprint": true,
      "showOpportunityZones": true,
      "showMarkers": true
    }
  },
  "dataViz": {
    "categorical": [
      "#4DD8E6",
      "#FFB020",
      "#62B6FF",
      "#FF8A4C",
      "#A3E635",
      "#E879C9"
    ],
    "sequential": [
      "#132721",
      "#173E2E",
      "#1E5D3F",
      "#258354",
      "#2DAA6A"
    ],
    "diverging": {
      "negative": "#FF5D6A",
      "neutral": "#3A424F",
      "positive": "#35D07F"
    },
    "heatTextRule": "Footprint fills are capped at 42% opacity so E8EDF2 text stays above 6.6:1. The top two intensity levels add a 2px heat bar, not more fill.",
    "noRainbow": "Never use a rainbow or jet scale for a single ordered metric."
  },
  "cli": {
    "table": {
      "unicode": true,
      "asciiFallback": "--ascii",
      "numericAlignment": "right",
      "maxWidth": 120,
      "borderStyle": "box-drawing rows only; no full outer box",
      "header": "uppercase mono micro label with dim rule"
    },
    "color": {
      "auto": "color when stdout is a TTY and NO_COLOR is unset",
      "flags": "--no-color, --color=always"
    },
    "formats": [
      "table",
      "json",
      "ndjson",
      "csv"
    ],
    "confirmation": {
      "standard": "[y/N], default N",
      "typed": "Type the exact token shown; anything else aborts",
      "liveEnableToken": "LIVE",
      "paperResetToken": "RESET",
      "killSwitch": "No confirmation. Stopping is always safe.",
      "killOffToken": "RESUME"
    },
    "exitCodes": {
      "ok": 0,
      "runtimeError": 1,
      "usageError": 2,
      "partialSuccess": 3,
      "blockedByRisk": 4,
      "authOrConfigError": 5
    },
    "timestamps": "ISO-8601 UTC by default; --local switches the display zone only, never the stored value."
  }
