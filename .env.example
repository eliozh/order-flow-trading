# Order Flow Trading - local development settings.
# Copy to .env and adjust. Never commit real credentials.
OFT_ENV=paper
OFT_HOST=127.0.0.1
OFT_PORT=7611
OFT_DATA_DIR=./data
OFT_LOG_LEVEL=INFO

# $OFT_DATA is accepted as an alias for $OFT_DATA_DIR.

# Future credentials. Leave empty here; real values belong in the OS keyring.
OFT_API_TOKEN=
OFT_BINANCE_API_KEY=
OFT_BINANCE_API_SECRET=
OFT_OPENAI_API_KEY=
OFT_ANTHROPIC_API_KEY=
OFT_DEEPSEEK_API_KEY=
OFT_TELEGRAM_BOT_TOKEN=

# Test-only: enables the legacy fixture debug scan path in OFT_ENV=test.
OFT_ALLOW_FIXTURE_SCAN_DEBUG=false
