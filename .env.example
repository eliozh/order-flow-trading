# Order Flow Trading - local development settings.
# Copy to .env and adjust. Never commit real credentials.
OFT_ENV=paper
OFT_HOST=127.0.0.1
OFT_PORT=7611
OFT_DATA_DIR=./data
OFT_LOG_LEVEL=INFO

# $OFT_DATA is accepted as an alias for $OFT_DATA_DIR.

# Future credentials. Leave empty here; real values belong in the OS keyring.
OFT_API_TOKEN=
OFT_BINANCE_API_KEY=
OFT_BINANCE_API_SECRET=
OFT_OPENAI_API_KEY=
OFT_ANTHROPIC_API_KEY=
OFT_DEEPSEEK_API_KEY=
OFT_TELEGRAM_BOT_TOKEN=

# Test-only: enables the legacy fixture debug scan path in OFT_ENV=test.
OFT_ALLOW_FIXTURE_SCAN_DEBUG=false

# LLM provider and role models. No default model is shipped; set each role you
# want to use. Base URLs are not secrets and may be logged.
OFT_LLM_PROVIDER=
OFT_LLM_MODEL_ANALYSIS=
OFT_LLM_MODEL_ENTRY_RECHECK=
OFT_LLM_MODEL_MANAGEMENT=
OFT_LLM_MODEL_REVIEW=
OFT_LLM_OPENAI_BASE_URL=https://api.openai.com
OFT_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
OFT_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only the official provider hosts above (plus loopback http) are accepted.
# Set this to true only if you intentionally route the key to a custom host.
OFT_LLM_ALLOW_CUSTOM_BASE_URL=false
# Optional operator price table JSON (see config/pricing.example.json). With no
# table every call is recorded as unpriced; no prices are bundled.
OFT_LLM_PRICE_TABLE=
# Per-provider concurrency caps (DeepSeek defaults to 1 while strict mode is beta).
OFT_LLM_MAX_CONCURRENCY=2
OFT_LLM_MAX_CONCURRENCY_DEEPSEEK=1

# Budget thresholds (ADR-0005). They alert but never stop calls.
OFT_BUDGET_DAILY_USD=10.00
OFT_BUDGET_WEEKLY_USD=50.00
OFT_BUDGET_MONTHLY_USD=150.00
OFT_BUDGET_WARN_PCT=80

# Trigger evaluator cadence (ADR-0007). The interval must be within 5-60 s.
OFT_TRIGGER_INTERVAL_SECONDS=15
# A snapshot older than this budget never triggers.
OFT_TRIGGER_STALE_AFTER_SECONDS=60
