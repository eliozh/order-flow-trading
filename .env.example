# Order Flow Trading - local development settings.
# Copy to .env and adjust. Never commit real credentials.
OFT_ENV=paper
OFT_HOST=127.0.0.1
OFT_PORT=7611
OFT_DATA_DIR=./data
OFT_LOG_LEVEL=INFO

# $OFT_DATA is accepted as an alias for $OFT_DATA_DIR.

# Credentials. Leave every value empty here. Real secrets belong in the OS
# keyring (preferred) or, when no keyring exists, the encrypted-file store.
OFT_API_TOKEN=
OFT_BINANCE_API_KEY=
OFT_BINANCE_API_SECRET=
OFT_OPENAI_API_KEY=
OFT_ANTHROPIC_API_KEY=
OFT_DEEPSEEK_API_KEY=
OFT_TELEGRAM_BOT_TOKEN=
# Encrypted-file secret store only; ignored when an OS keyring is available.
# Minimum 32 characters. Leave empty here and never commit a real value.
OFT_MASTER_KEY=

# Market-data fixtures and optional archive fixtures. The built-in fixtures
# directory points at the repository fixtures; this sample uses the same path
# repo-relative. An empty archive fixture dir leaves HTTPS archive access in
# place outside tests and disables it under OFT_ENV=test.
OFT_FIXTURES_DIR=./tests/fixtures/market
OFT_ARCHIVE_FIXTURE_DIR=

# Test-only: enables the legacy fixture debug scan path in OFT_ENV=test.
OFT_ALLOW_FIXTURE_SCAN_DEBUG=false

# LLM provider and role models. No default model is shipped; set each role you
# want to use. Base URLs are not secrets and may be logged.
OFT_LLM_PROVIDER=
OFT_LLM_MODEL_ANALYSIS=
OFT_LLM_MODEL_ENTRY_RECHECK=
OFT_LLM_MODEL_MANAGEMENT=
OFT_LLM_MODEL_REVIEW=
OFT_LLM_OPENAI_BASE_URL=https://api.openai.com
OFT_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
OFT_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only the official provider hosts above (plus loopback http) are accepted.
# Set this to true only if you intentionally route the key to a custom host.
OFT_LLM_ALLOW_CUSTOM_BASE_URL=false
# Optional operator price table JSON (see config/pricing.example.json). With no
# table every call is recorded as unpriced; no prices are bundled.
OFT_LLM_PRICE_TABLE=
# Per-provider concurrency caps (DeepSeek defaults to 1 while strict mode is beta).
OFT_LLM_MAX_CONCURRENCY=2
OFT_LLM_MAX_CONCURRENCY_DEEPSEEK=1

# Budget thresholds (ADR-0005). They alert but never stop calls.
OFT_BUDGET_DAILY_USD=10.00
OFT_BUDGET_WEEKLY_USD=50.00
OFT_BUDGET_MONTHLY_USD=150.00
OFT_BUDGET_WARN_PCT=80

# Scan cadence (ADR-0007). Allowed periods: 4h, 8h. Jitter must satisfy
# 0 <= OFT_SCAN_JITTER_SECONDS < scan period seconds. The daemon additionally
# requires <= 14399 s (the overlay cap for the smallest supported period);
# larger values are rejected, not clamped.
OFT_SCAN_PERIOD=4h
OFT_SCAN_JITTER_SECONDS=30

# Trigger evaluator cadence (ADR-0007). The interval must be within 5-60 s.
OFT_TRIGGER_INTERVAL_SECONDS=15
# A snapshot older than this budget never triggers.
OFT_TRIGGER_STALE_AFTER_SECONDS=60

# Code-only position monitor cadence in seconds (ADR-0007, 5-60).
OFT_POSITION_MONITOR_INTERVAL_SECONDS=15
# Management cadence: empty follows the active scan period; "4h"/"8h" pins it.
OFT_MANAGEMENT_CADENCE=
# Add FUNDING_SETTLEMENT / RISK_BREACH to the automated management conditions.
OFT_MANAGEMENT_FUNDING_SETTLEMENT_ENABLED=true
OFT_MANAGEMENT_RISK_BREACH_ENABLED=true

# Paper broker defaults (ADR-0006): starting balance in USD, slippage and taker
# fee in basis points. These set the paper P&L basis.
OFT_PAPER_INITIAL_BALANCE=10000.00
OFT_PAPER_SLIPPAGE_BPS=2
OFT_PAPER_TAKER_FEE_BPS=5

# Percentage-based risk caps (ADR-0006). Percentages are of current equity;
# an operator row persisted by `oft risk set` overrides these values.
OFT_RISK_PER_TRADE_PCT=0.8
OFT_RISK_MAX_CONCURRENT_POSITIONS=3
OFT_RISK_DAILY_LOSS_PCT=3.0
OFT_RISK_MAX_LEVERAGE=5.0
OFT_RISK_MAX_NOTIONAL_PCT=20.0
OFT_RISK_MAX_SLIPPAGE_BPS=25.0
OFT_RISK_MAX_SPREAD_BPS=15.0
OFT_RISK_STALE_MARK_SECONDS=60
