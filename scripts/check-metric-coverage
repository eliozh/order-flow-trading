#!/usr/bin/env python3
"""Fail when a deterministic primitive is below 100% branch coverage.

Run after ``pytest --cov=oft --cov-branch``. The gate covers the deterministic
metric core (CVD, delta, footprint, volume profile, funding, OI,
liquidations, versioning, and the exact-decimal renderer) plus the risk gate,
the trigger state machine, and the OMS state machine. These modules have no
I/O and are fully unit-testable, so partial branches are regressions rather
than acceptable gaps. Targets are package-relative paths because names such as
``risk.py`` and ``trigger.py`` also exist in other packages.
"""

from __future__ import annotations

import sys
from pathlib import Path

import coverage

TARGETS = (
    "domain/metrics/cvd.py",
    "domain/metrics/delta.py",
    "domain/metrics/footprint.py",
    "domain/metrics/types.py",
    "domain/metrics/volume_profile.py",
    "domain/metrics/funding.py",
    "domain/metrics/open_interest.py",
    "domain/metrics/liquidations.py",
    "domain/metrics/version.py",
    "domain/risk.py",
    "domain/trigger.py",
    "domain/oms.py",
)
DEFAULT_DATA_FILE = ".coverage"


def _matches(path: Path, target_parts: tuple[str, ...]) -> bool:
    return path.parts[-len(target_parts) :] == target_parts


def main(argv: list[str]) -> int:
    data_file = argv[1] if len(argv) > 1 else DEFAULT_DATA_FILE
    if not Path(data_file).is_file():
        print(f"error: coverage data file not found: {data_file}", file=sys.stderr)
        return 1

    cov = coverage.Coverage(data_file=data_file)
    cov.load()
    measured_paths = tuple(Path(path) for path in cov.get_data().measured_files())
    failures: list[str] = []
    for target in TARGETS:
        target_parts = tuple(Path(target).parts)
        matches = [path for path in measured_paths if _matches(path, target_parts)]
        if len(matches) != 1:
            failures.append(f"{target}: expected exactly one measured path, found {len(matches)}")
            continue
        path = str(matches[0])
        analysis = cov._analyze(path)
        statements = analysis.statements
        missing = sorted(analysis.missing)
        missing_branches = analysis.missing_branch_arcs()
        if missing or missing_branches:
            failures.append(
                f"{target}: missing lines {missing or []}, missing branches {missing_branches or []}"
                f" ({len(statements)} statements)"
            )

    if failures:
        print("metric branch gate failed (require 100%):", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1

    print("metric branch gate: 100% branch coverage for " + ", ".join(TARGETS))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
